//@version=6
indicator("MSL - SRE", overlay = true, max_lines_count = 500, max_boxes_count = 500, max_labels_count = 500)

// ─── Groups ───
GROUP_LIFECYCLE = "Lifecycle"
GROUP_DISPLAY   = "Display"
GROUP_HIGH      = "High Levels & Zones"
GROUP_LOW       = "Low Levels & Zones"
GROUP_LABELS    = "Labels"

// ─── Lifecycle ───
maxAgeBars   = input.int(120, "Max Level Age (Bars)", minval = 1, maxval = 5000, group = GROUP_LIFECYCLE, tooltip = "A registered high/low (line, zone, label) is fully deleted once it is older than this many bars.")
zoneProjBars = input.int(20, "Zone Forward Projection (Bars)", minval = 1, maxval = 500, group = GROUP_LIFECYCLE, tooltip = "A sweep zone always ends this many bars ahead of the current candle.")

// ─── Display toggles ───
showPendingLevels = input.bool(true, "Show Pending (Unswept) Levels", group = GROUP_DISPLAY, tooltip = "The line that tracks a registered wick while it waits to be swept.")
showConnectors    = input.bool(true, "Show Sweep Connector Rays", group = GROUP_DISPLAY, tooltip = "The ray from the swept wick to the sweeping candle. Independent of the pending level line.")
showZones         = input.bool(true, "Show Sweep Zones", group = GROUP_DISPLAY)
showLabels        = input.bool(true, "Show H/L Pattern Labels", group = GROUP_DISPLAY)

// ─── High styling ───
highLineColor            = input.color(color.new(color.red, 40), "Pending Level Color", group = GROUP_HIGH)
highLineWidth            = input.int(1, "Pending Level Width", minval = 1, maxval = 5, group = GROUP_HIGH)
highLineStyleInput       = input.string("Dotted", "Pending Level Style", options = ["Solid", "Dashed", "Dotted"], group = GROUP_HIGH)
highConnColor            = input.color(color.red, "Connector Ray Color", group = GROUP_HIGH)
highConnWidth            = input.int(1, "Connector Ray Width", minval = 1, maxval = 5, group = GROUP_HIGH)
highConnStyleInput       = input.string("Solid", "Connector Ray Style", options = ["Solid", "Dashed", "Dotted"], group = GROUP_HIGH)
highZoneColor            = input.color(color.new(color.red, 80), "Zone Background", group = GROUP_HIGH)
highZoneBorder           = input.color(color.red, "Zone Border Color", group = GROUP_HIGH)
highZoneBorderWidth      = input.int(1, "Zone Border Width", minval = 1, maxval = 5, group = GROUP_HIGH)
highZoneBorderStyleInput = input.string("Solid", "Zone Border Style", options = ["Solid", "Dashed", "Dotted"], group = GROUP_HIGH)

// ─── Low styling ───
lowLineColor            = input.color(color.new(color.green, 40), "Pending Level Color", group = GROUP_LOW)
lowLineWidth            = input.int(1, "Pending Level Width", minval = 1, maxval = 5, group = GROUP_LOW)
lowLineStyleInput       = input.string("Dotted", "Pending Level Style", options = ["Solid", "Dashed", "Dotted"], group = GROUP_LOW)
lowConnColor            = input.color(color.green, "Connector Ray Color", group = GROUP_LOW)
lowConnWidth            = input.int(1, "Connector Ray Width", minval = 1, maxval = 5, group = GROUP_LOW)
lowConnStyleInput       = input.string("Solid", "Connector Ray Style", options = ["Solid", "Dashed", "Dotted"], group = GROUP_LOW)
lowZoneColor            = input.color(color.new(color.green, 80), "Zone Background", group = GROUP_LOW)
lowZoneBorder           = input.color(color.green, "Zone Border Color", group = GROUP_LOW)
lowZoneBorderWidth      = input.int(1, "Zone Border Width", minval = 1, maxval = 5, group = GROUP_LOW)
lowZoneBorderStyleInput = input.string("Solid", "Zone Border Style", options = ["Solid", "Dashed", "Dotted"], group = GROUP_LOW)

// ─── Label styling ───
labelSizeInput = input.string("Tiny", "Label Size", options = ["Tiny", "Small", "Normal", "Large"], group = GROUP_LABELS)
highLabelColor = input.color(color.red, "High Label Color", group = GROUP_LABELS)
lowLabelColor  = input.color(color.green, "Low Label Color", group = GROUP_LABELS)

f_style(s) =>
    switch s
        "Solid"  => line.style_solid
        "Dashed" => line.style_dashed
        => line.style_dotted

f_size(s) =>
    switch s
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        => size.large

// ─── State: registered highs ───
var array<float> hLevel  = array.new<float>()
var array<bool>  hSwept  = array.new<bool>()
var array<box>   hBox    = array.new<box>()
var array<line>  hLine   = array.new<line>()
var array<label> hLbl    = array.new<label>()
var array<int>   hOrigin = array.new<int>()

// ─── State: registered lows ───
var array<float> lLevel  = array.new<float>()
var array<bool>  lSwept  = array.new<bool>()
var array<box>   lBox    = array.new<box>()
var array<line>  lLine   = array.new<line>()
var array<label> lLbl    = array.new<label>()
var array<int>   lOrigin = array.new<int>()

bull2 = close[2] > open[2]
bear2 = close[2] < open[2]
bull1 = close[1] > open[1]
bear1 = close[1] < open[1]
bull0 = close > open
bear0 = close < open

// Highs: bull, bear, bull that fails to close above candle-1's close
//        OR bull, bear, bear
highFormA = bull2 and bear1 and bull0 and close <= close[2]
highFormB = bull2 and bear1 and bear0
highFormed = bar_index > 2 and (highFormA or highFormB)

// Lows: vice versa
lowFormA = bear2 and bull1 and bear0 and close >= close[2]
lowFormB = bear2 and bull1 and bull0
lowFormed = bar_index > 2 and (lowFormA or lowFormB)

// ─── Register a new high (highest wick of the 3 candles) ───
if highFormed
    offset  = high[2] >= high[1] and high[2] >= high[0] ? 2 : (high[1] >= high[0] ? 1 : 0)
    wickVal = math.max(high[2], math.max(high[1], high))
    wickBar = bar_index - offset

    line newLine = na
    if showPendingLevels
        newLine := line.new(wickBar, wickVal, bar_index, wickVal, color = highLineColor, width = highLineWidth, style = f_style(highLineStyleInput))

    label newLbl = na
    if showLabels
        newLbl := label.new(wickBar, wickVal, "H", style = label.style_label_down, color = color.new(color.white, 100), textcolor = highLabelColor, size = f_size(labelSizeInput))

    array.push(hLevel, wickVal)
    array.push(hSwept, false)
    array.push(hBox, na)
    array.push(hLine, newLine)
    array.push(hLbl, newLbl)
    array.push(hOrigin, wickBar)

// ─── Register a new low (lowest wick of the 3 candles) ───
if lowFormed
    offset  = low[2] <= low[1] and low[2] <= low[0] ? 2 : (low[1] <= low[0] ? 1 : 0)
    wickVal = math.min(low[2], math.min(low[1], low))
    wickBar = bar_index - offset

    line newLine = na
    if showPendingLevels
        newLine := line.new(wickBar, wickVal, bar_index, wickVal, color = lowLineColor, width = lowLineWidth, style = f_style(lowLineStyleInput))

    label newLbl = na
    if showLabels
        newLbl := label.new(wickBar, wickVal, "L", style = label.style_label_up, color = color.new(color.white, 100), textcolor = lowLabelColor, size = f_size(labelSizeInput))

    array.push(lLevel, wickVal)
    array.push(lSwept, false)
    array.push(lBox, na)
    array.push(lLine, newLine)
    array.push(lLbl, newLbl)
    array.push(lOrigin, wickBar)

bool highZoneAlert = false
bool lowZoneAlert  = false

// ─── Process high levels: sweep, kill, or expire ───
if array.size(hLevel) > 0
    for i = array.size(hLevel) - 1 to 0
        H = array.get(hLevel, i)
        swept = array.get(hSwept, i)
        origin = array.get(hOrigin, i)
        expired = (bar_index - origin) >= maxAgeBars
        killed = close > H
        if killed or expired
            b = array.get(hBox, i)
            if not na(b)
                box.delete(b)
            ln = array.get(hLine, i)
            if not na(ln)
                line.delete(ln)
            lb = array.get(hLbl, i)
            if not na(lb)
                label.delete(lb)
            array.remove(hLevel, i)
            array.remove(hSwept, i)
            array.remove(hBox, i)
            array.remove(hLine, i)
            array.remove(hLbl, i)
            array.remove(hOrigin, i)
        else if not swept
            ln = array.get(hLine, i)
            if not na(ln)
                line.set_x2(ln, bar_index)
            if bull0 and high > H and close < H
                // sweep confirmed: pending line becomes the connector ray
                if showConnectors
                    if na(ln)
                        ln := line.new(origin, H, bar_index, H, color = highConnColor, width = highConnWidth, style = f_style(highConnStyleInput))
                        array.set(hLine, i, ln)
                    else
                        line.set_x2(ln, bar_index)
                        line.set_color(ln, highConnColor)
                        line.set_width(ln, highConnWidth)
                        line.set_style(ln, f_style(highConnStyleInput))
                else if not na(ln)
                    line.delete(ln)
                    array.set(hLine, i, na)
                box newBox = na
                if showZones
                    newBox := box.new(left = bar_index, top = high, right = bar_index + zoneProjBars, bottom = close, border_color = highZoneBorder, border_width = highZoneBorderWidth, border_style = f_style(highZoneBorderStyleInput), bgcolor = highZoneColor)
                array.set(hBox, i, newBox)
                array.set(hSwept, i, true)
                highZoneAlert := true
        else
            bx = array.get(hBox, i)
            if not na(bx)
                box.set_right(bx, bar_index + zoneProjBars)

// ─── Process low levels: sweep, kill, or expire ───
if array.size(lLevel) > 0
    for i = array.size(lLevel) - 1 to 0
        L = array.get(lLevel, i)
        swept = array.get(lSwept, i)
        origin = array.get(lOrigin, i)
        expired = (bar_index - origin) >= maxAgeBars
        killed = close < L
        if killed or expired
            b = array.get(lBox, i)
            if not na(b)
                box.delete(b)
            ln = array.get(lLine, i)
            if not na(ln)
                line.delete(ln)
            lb = array.get(lLbl, i)
            if not na(lb)
                label.delete(lb)
            array.remove(lLevel, i)
            array.remove(lSwept, i)
            array.remove(lBox, i)
            array.remove(lLine, i)
            array.remove(lLbl, i)
            array.remove(lOrigin, i)
        else if not swept
            ln = array.get(lLine, i)
            if not na(ln)
                line.set_x2(ln, bar_index)
            if bear0 and low < L and close > L
                // sweep confirmed: pending line becomes the connector ray
                if showConnectors
                    if na(ln)
                        ln := line.new(origin, L, bar_index, L, color = lowConnColor, width = lowConnWidth, style = f_style(lowConnStyleInput))
                        array.set(lLine, i, ln)
                    else
                        line.set_x2(ln, bar_index)
                        line.set_color(ln, lowConnColor)
                        line.set_width(ln, lowConnWidth)
                        line.set_style(ln, f_style(lowConnStyleInput))
                else if not na(ln)
                    line.delete(ln)
                    array.set(lLine, i, na)
                box newBox = na
                if showZones
                    newBox := box.new(left = bar_index, top = close, right = bar_index + zoneProjBars, bottom = low, border_color = lowZoneBorder, border_width = lowZoneBorderWidth, border_style = f_style(lowZoneBorderStyleInput), bgcolor = lowZoneColor)
                array.set(lBox, i, newBox)
                array.set(lSwept, i, true)
                lowZoneAlert := true
        else
            bx = array.get(lBox, i)
            if not na(bx)
                box.set_right(bx, bar_index + zoneProjBars)

// ─── Alerts: one confirmed notification per bar close, covering both sides ───
string alertSide = highZoneAlert and lowZoneAlert ? "High + Low sweep zone" : highZoneAlert ? "High sweep zone" : lowZoneAlert ? "Low sweep zone" : ""
if alertSide != ""
    alert("MSL - SRE: " + alertSide + " | " + syminfo.ticker + " " + timeframe.period + " @ " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)

alertcondition(highZoneAlert, "MSL - SRE: High sweep zone", "MSL - SRE: High sweep zone confirmed")
alertcondition(lowZoneAlert, "MSL - SRE: Low sweep zone", "MSL - SRE: Low sweep zone confirmed")

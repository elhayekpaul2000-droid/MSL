//@version=6
indicator("MSL Bias Engine — Sweep + BOS", overlay = true, max_lines_count = 500, max_labels_count = 500)

// ═══════════════════════════ INPUTS ═══════════════════════════
gS = "Structure"
N         = input.int(2,    "Fractal left/right bars",            minval = 1, group = gS)
useWick   = input.bool(true,  "Wick sweep",                                   group = gS)
useClose  = input.bool(true,  "Close sweep (reclaim body)",                   group = gS)
maxCloses = input.int(3,    "Max closes beyond level",            minval = 1, group = gS)
reqSweep  = input.bool(true,  "Require sweep to mint protected level",        group = gS)

gV = "Visuals"
showPiv  = input.bool(false, "Show fractals",            group = gV)
showProt = input.bool(true,  "Show protected level",     group = gV)
showFlip = input.bool(true,  "Show flip labels",         group = gV)
showSwp  = input.bool(true,  "Show sweeps",              group = gV)
tintBg   = input.bool(true,  "Tint background",          group = gV)
cBull    = input.color(#26a69a, "Bullish", group = gV)
cBear    = input.color(#ef5350, "Bearish", group = gV)

// ═══════════════════════════ FRACTALS ═════════════════════════
ph = ta.pivothigh(N, N)
pl = ta.pivotlow(N, N)

var float swHigh  = na   // most recent confirmed swing high
var float swHiBod = na   // its body top  = max(open, close)
var float swLow   = na   // most recent confirmed swing low
var float swLoBod = na   // its body base = min(open, close)
var bool  hiBroke = false
var bool  loBroke = false
var int   clsUp   = 0
var int   clsDn   = 0
var float hiSince = na   // highest high since swHigh formed
var float loSince = na   // lowest low  since swLow  formed

if not na(ph)
    swHigh  := ph
    swHiBod := math.max(open[N], close[N])
    hiBroke := false
    clsUp   := 0
    hiSince := ph

if not na(pl)
    swLow   := pl
    swLoBod := math.min(open[N], close[N])
    loBroke := false
    clsDn   := 0
    loSince := pl

if not na(swHigh)
    hiSince := na(hiSince) ? high : math.max(hiSince, high)
if not na(swLow)
    loSince := na(loSince) ? low : math.min(loSince, low)

// ═══════════════════════════ SWEEP DETECTION ══════════════════
// Wick sweep : pierces the level, closes back inside, no close beyond.
// Close sweep: 1..maxCloses closes beyond, then a close back past the body.
// More than maxCloses closes beyond = genuine break, level retired.
sweptHi = false
if not na(swHigh) and not hiBroke
    if close > swHigh
        clsUp += 1
        if clsUp > maxCloses
            hiBroke := true
            clsUp   := 0
    else
        if useClose and clsUp >= 1 and close < swHiBod
            sweptHi := true
        if useWick and clsUp == 0 and high > swHigh
            sweptHi := true
        clsUp := 0

sweptLo = false
if not na(swLow) and not loBroke
    if close < swLow
        clsDn += 1
        if clsDn > maxCloses
            loBroke := true
            clsDn   := 0
    else
        if useClose and clsDn >= 1 and close > swLoBod
            sweptLo := true
        if useWick and clsDn == 0 and low < swLow
            sweptLo := true
        clsDn := 0

// ═══════════════════════════ ARMED SETUPS ═════════════════════
// A sweep arms a mint. The mint completes on the BOS close.
var bool  armBr  = false   // bear: swept a high, waiting for close below swing low
var float brHi   = na      // the sweeping high  -> becomes protected high
var float brLvl  = na      // BOS level (swing low at time of sweep)
var bool  armBl  = false   // bull: swept a low, waiting for close above swing high
var float blLo   = na      // the sweeping low   -> becomes protected low
var float blLvl  = na      // BOS level (swing high at time of sweep)

if sweptHi and not na(swLow)
    armBr := true
    brHi  := hiSince
    brLvl := swLow
if sweptLo and not na(swHigh)
    armBl := true
    blLo  := loSince
    blLvl := swHigh

// ═══════════════════════════ BIAS ENGINE ══════════════════════
var int   bias   = 0    //  1 bull | -1 bear | 0 neutral
var float protHi = na
var float protLo = na
var float phHi   = na   // highest high of current phase
var float phLo   = na   // lowest  low  of current phase

phHi := na(phHi) ? high : math.max(phHi, high)
phLo := na(phLo) ? low  : math.min(phLo, low)

flipB   = false  // -> bearish
flipU   = false  // -> bullish
srcBrSw = false  // bear flip came from sweep+BOS mint
srcBlSw = false  // bull flip came from sweep+BOS mint

// 1) Protected level break — unconditional, dominant rule.
if bias == 1 and not na(protLo) and close < protLo
    flipB := true
if bias == -1 and not na(protHi) and close > protHi
    flipU := true

// 2) Sweep + BOS mint (with invalidation on reclaim of the sweep extreme).
if armBr and not flipB
    if close > brHi
        armBr := false
    else if close < brLvl and bias != -1
        flipB   := true
        srcBrSw := true
if armBl and not flipU
    if close < blLo
        armBl := false
    else if close > blLvl and bias != 1
        flipU   := true
        srcBlSw := true

// 3) Optional: mint without a sweep (toggle off "Require sweep").
if not reqSweep
    if not flipB and bias != -1 and not na(swLow) and close < swLow
        flipB := true
    if not flipU and bias != 1 and not na(swHigh) and close > swHigh
        flipU := true

didB = false
didU = false

if flipB and bias != -1
    protHi := srcBrSw ? brHi : phHi
    bias   := -1
    phHi   := high
    phLo   := low
    armBr  := false
    armBl  := false
    didB   := true

if flipU and bias != 1
    protLo := srcBlSw ? blLo : phLo
    bias   := 1
    phHi   := high
    phLo   := low
    armBr  := false
    armBl  := false
    didU   := true

// ═══════════════════════════ VISUALS ══════════════════════════
biasCol = bias == 1 ? cBull : bias == -1 ? cBear : color.gray

actLvl = bias == 1 ? protLo : bias == -1 ? protHi : na
plot(showProt ? actLvl : na, "Protected level", color = biasCol, style = plot.style_linebr, linewidth = 2)

bgcolor(tintBg and bias != 0 ? color.new(biasCol, 92) : na)

plotshape(showPiv and not na(ph), "Fractal high", shape.triangledown, location.abovebar, color.new(cBear, 40), offset = -N, size = size.tiny)
plotshape(showPiv and not na(pl), "Fractal low",  shape.triangleup,   location.belowbar, color.new(cBull, 40), offset = -N, size = size.tiny)

plotshape(showSwp and sweptHi, "Sweep high", shape.xcross, location.abovebar, color.new(cBear, 0), size = size.tiny)
plotshape(showSwp and sweptLo, "Sweep low",  shape.xcross, location.belowbar, color.new(cBull, 0), size = size.tiny)

if showFlip and didB
    label.new(bar_index, high, "BEAR", style = label.style_label_down, color = cBear, textcolor = color.white, size = size.small)
if showFlip and didU
    label.new(bar_index, low, "BULL", style = label.style_label_up, color = cBull, textcolor = color.white, size = size.small)

// ═══════════════════════════ ALERTS ═══════════════════════════
alertcondition(didB, "Bias -> Bearish", "Bias flipped BEARISH")
alertcondition(didU, "Bias -> Bullish", "Bias flipped BULLISH")

plot(bias, "Bias (1/-1)", display = display.data_window)

//@version=6
indicator(
    "MSL — Directional Candles",
    shorttitle = "MSL DC",
    overlay = true,
    max_boxes_count = 500
)

//──────────────────────────────────────────────────────────────────────
// Constants
//──────────────────────────────────────────────────────────────────────

// How far back the zone candle may be searched for. The zone candle is
// always the opposite colour to the order block's purpose, so on a sweep
// whose swept candle is the wrong colour the search steps back until it
// finds a valid one. Nearest match is normally 1-3 bars away.
const int ZONE_CANDLE_SEARCH = 10

const string GROUP_LOGIC = "Directional Candles"
const string GROUP_ZONE  = "Zone Fill & Border"
const string GROUP_TEXT  = "Zone Text"

//──────────────────────────────────────────────────────────────────────
// Inputs
//──────────────────────────────────────────────────────────────────────

// Zones are scanned on every bar of history but are removed (object +
// internal state) once they are older than this many bars.
int lookbackBars = input.int(
     60,
     "Lookback / max zone age (bars)",
     minval  = 2,
     maxval  = 500,
     tooltip = "Zones older than this are deleted from the chart and from memory.",
     group   = GROUP_LOGIC
)

int forwardBars = input.int(
     20,
     "Forward projection (bars)",
     minval  = 0,
     maxval  = 500,
     tooltip = "How far past the current candle each zone is drawn.",
     group   = GROUP_LOGIC
)

// ── Fill & border ─────────────────────────────────────────────────────

color bullColor = input.color(color.teal, "Bullish zone color", group = GROUP_ZONE)
color bearColor = input.color(color.red,  "Bearish zone color", group = GROUP_ZONE)

int fillTransparency = input.int(
     85,
     "Fill transparency",
     minval = 0,
     maxval = 100,
     group  = GROUP_ZONE
)

bool showBorders = input.bool(true, "Show borders", group = GROUP_ZONE)

int borderTransparency = input.int(
     0,
     "Border transparency",
     minval = 0,
     maxval = 100,
     group  = GROUP_ZONE
)

int borderWidth = input.int(
     1,
     "Border width",
     minval = 1,
     maxval = 4,
     group  = GROUP_ZONE
)

string borderStyleInput = input.string(
     "Solid",
     "Border style",
     options = ["Solid", "Dashed", "Dotted"],
     group   = GROUP_ZONE
)

// ── Text ──────────────────────────────────────────────────────────────

bool showZoneText = input.bool(true, "Show zone text", group = GROUP_TEXT)

string bullText = input.string("Bullish", "Bullish label", group = GROUP_TEXT)
string bearText = input.string("Bearish", "Bearish label", group = GROUP_TEXT)

color textColor = input.color(color.white, "Text color", group = GROUP_TEXT)

string textSizeInput = input.string(
     "Normal",
     "Text size",
     options = ["Tiny", "Small", "Normal", "Large", "Huge"],
     group   = GROUP_TEXT
)

string hAlignInput = input.string(
     "Center",
     "Text horizontal align",
     options = ["Left", "Center", "Right"],
     group   = GROUP_TEXT
)

string vAlignInput = input.string(
     "Center",
     "Text vertical align",
     options = ["Top", "Center", "Bottom"],
     group   = GROUP_TEXT
)

string fontInput = input.string(
     "Default",
     "Font",
     options = ["Default", "Monospace"],
     group   = GROUP_TEXT
)

// ── Resolved cosmetic constants ───────────────────────────────────────

string borderStyle = borderStyleInput == "Dashed" ? line.style_dashed : borderStyleInput == "Dotted" ? line.style_dotted : line.style_solid

string textSize = textSizeInput == "Tiny" ? size.tiny : textSizeInput == "Small" ? size.small : textSizeInput == "Large" ? size.large : textSizeInput == "Huge" ? size.huge : size.normal

string hAlign = hAlignInput == "Left" ? text.align_left : hAlignInput == "Right" ? text.align_right : text.align_center

string vAlign = vAlignInput == "Top" ? text.align_top : vAlignInput == "Bottom" ? text.align_bottom : text.align_center

string fontFamily = fontInput == "Monospace" ? font.family_monospace : font.family_default

//──────────────────────────────────────────────────────────────────────
// State
//
// One entry per live zone, kept in parallel arrays so that a zone is
// dropped from memory at the same moment its box is deleted.
//──────────────────────────────────────────────────────────────────────

var array<box>   zoneBox    = array.new<box>()
var array<float> zoneTop    = array.new<float>()
var array<float> zoneBot    = array.new<float>()
var array<int>   zoneStart  = array.new<int>()
var array<bool>  zoneIsBull = array.new<bool>()

createZone(bool isBull, float top, float bot, int startBar) =>
    color baseColor = isBull ? bullColor : bearColor
    box b = box.new(
         left             = startBar,
         top              = top,
         right            = bar_index + forwardBars,
         bottom           = bot,
         border_color     = showBorders ? color.new(baseColor, borderTransparency) : color.new(baseColor, 100),
         border_width     = showBorders ? borderWidth : 0,
         border_style     = borderStyle,
         bgcolor          = color.new(baseColor, fillTransparency),
         text             = showZoneText ? (isBull ? bullText : bearText) : "",
         text_color       = textColor,
         text_size        = textSize,
         text_halign      = hAlign,
         text_valign      = vAlign,
         text_font_family = fontFamily,
         xloc             = xloc.bar_index
     )
    array.push(zoneBox,    b)
    array.push(zoneTop,    top)
    array.push(zoneBot,    bot)
    array.push(zoneStart,  startBar)
    array.push(zoneIsBull, isBull)

deleteZone(int i) =>
    box.delete(array.get(zoneBox, i))
    array.remove(zoneBox,    i)
    array.remove(zoneTop,    i)
    array.remove(zoneBot,    i)
    array.remove(zoneStart,  i)
    array.remove(zoneIsBull, i)

// True when a zone of the same direction already sits on that candle.
// Stops back-to-back triggers from stacking duplicate boxes.
zoneExists(int startBar, bool isBull) =>
    bool found = false
    if array.size(zoneStart) > 0
        for i = 0 to array.size(zoneStart) - 1
            if array.get(zoneStart, i) == startBar and array.get(zoneIsBull, i) == isBull
                found := true
                break
    found

// Offset of the nearest candle before the trigger whose colour is
// opposite to the zone's purpose: a bullish zone is always drawn on a
// bearish candle, a bearish zone always on a bullish candle.
// Returns -1 when no such candle is within reach.
zoneCandleOffset(bool isBull) =>
    int offset = -1
    for j = 1 to ZONE_CANDLE_SEARCH
        if j > bar_index
            break
        if (isBull ? close[j] < open[j] : close[j] > open[j])
            offset := j
            break
    offset

//──────────────────────────────────────────────────────────────────────
// Housekeeping: hard invalidation + age expiry, then extend survivors
//
// Invalidation is only judged on a confirmed close, so a zone is never
// removed on an intrabar tick that the bar later closes back inside of.
//──────────────────────────────────────────────────────────────────────

if array.size(zoneBox) > 0
    for i = array.size(zoneBox) - 1 to 0
        float top    = array.get(zoneTop, i)
        float bot    = array.get(zoneBot, i)
        bool  isBull = array.get(zoneIsBull, i)

        // Bullish zone dies on a close below its wick low.
        // Bearish zone dies on a close above its wick high.
        bool invalidated = barstate.isconfirmed and (isBull ? close < bot : close > top)
        bool expired     = bar_index - array.get(zoneStart, i) > lookbackBars

        if invalidated or expired
            deleteZone(i)
        else
            box.set_right(array.get(zoneBox, i), bar_index + forwardBars)

//──────────────────────────────────────────────────────────────────────
// Detection
//
// Bearish directional candle:
//   A) bear candle that sweeps the previous candle's wick high and
//      closes below that candle's wick low.
//   B) bull0, then bull1 that fails to close above bull0's wick high,
//      then a bear candle that closes below bull1's wick low.
// Bullish is the exact mirror.
//
// Zone = wick low to wick high of one candle only: the nearest candle
// before the trigger that is the opposite colour to the zone. For the
// three-bar pattern that is always the second push candle.
//──────────────────────────────────────────────────────────────────────

bool bullBar = close > open
bool bearBar = close < open

bool bearSweep = bearBar and high > high[1] and close < low[1]
bool bullSweep = bullBar and low  < low[1]  and close > high[1]

bool bearPush = bullBar[2] and bullBar[1] and close[1] <= high[2] and bearBar and close < low[1]
bool bullPush = bearBar[2] and bearBar[1] and close[1] >= low[2]  and bullBar and close > high[1]

if barstate.isconfirmed and bar_index > 2
    bool newBear = bearSweep or bearPush
    bool newBull = bullSweep or bullPush
    if newBear or newBull
        bool isBull = newBull
        int  offset = zoneCandleOffset(isBull)
        if offset > 0 and not zoneExists(bar_index - offset, isBull)
            createZone(isBull, high[offset], low[offset], bar_index - offset)

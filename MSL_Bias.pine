//@version=6
indicator("MSL- Bias", overlay = true, max_labels_count = 500)

// ---------------- inputs ----------------
cHigh   = input.color(color.red,   "Protected high")
cLow    = input.color(color.green, "Protected low")
useTint = input.bool(true,         "Bias background")

SCAN = 60
RECW = 4
BOSN = 3

// ---------------- types ----------------
type Lvl
    float px
    float body
    int   bn
    bool  isHigh

type Pend
    float px
    float body
    bool  isHigh
    int   bn
    float swpx
    bool  needRec
    int   recCnt
    bool  valid
    bool  bosOn
    float bosBody
    int   bosCnt

type Circ
    label lb
    float px
    bool  isHigh

var array<Lvl>  lvls  = array.new<Lvl>()
var array<Pend> pends = array.new<Pend>()
var array<Circ> circs = array.new<Circ>()
var int bias = 0

// ---------------- engine (closed candles only) ----------------
if barstate.isconfirmed
    int cutoff = bar_index - SCAN

    // --- age out old levels
    if array.size(lvls) > 0
        for i = array.size(lvls) - 1 to 0
            if array.get(lvls, i).bn < cutoff
                array.remove(lvls, i)

    // --- age out old pending sweeps
    if array.size(pends) > 0
        for i = array.size(pends) - 1 to 0
            if array.get(pends, i).bn < cutoff
                array.remove(pends, i)

    // --- progress pending sweeps
    if array.size(pends) > 0
        for i = array.size(pends) - 1 to 0
            Pend p = array.get(pends, i)
            bool drop = false

            if p.needRec
                // swept by close: must reclaim bodyclose within RECW candles
                p.recCnt += 1
                if p.isHigh ? close < p.body : close > p.body
                    p.needRec := false
                    p.valid   := true
                else if p.recCnt >= RECW
                    drop := true

            else if p.valid
                if p.bosOn
                    // BOS confirmation window
                    if p.isHigh ? close >= p.bosBody : close <= p.bosBody
                        drop := true
                    else
                        p.bosCnt += 1
                        if p.bosCnt >= BOSN
                            // confirmed protected level
                            label lb = label.new(x = p.bn, y = p.swpx, xloc = xloc.bar_index, text = "", style = label.style_circle, color = p.isHigh ? cHigh : cLow, size = size.tiny)
                            array.push(circs, Circ.new(lb, p.swpx, p.isHigh))
                            bias := p.isHigh ? -1 : 1
                            drop := true
                else
                    // HH / LL by close before BOS confirms = invalid
                    if p.isHigh ? close > p.body : close < p.body
                        drop := true
                    else
                        // look for BOS through the most recent opposite level
                        float refPx   = na
                        float refBody = na
                        int   refBn   = -1
                        if array.size(lvls) > 0
                            for j = 0 to array.size(lvls) - 1
                                Lvl L = array.get(lvls, j)
                                if L.isHigh != p.isHigh and L.bn > refBn
                                    refBn   := L.bn
                                    refPx   := L.px
                                    refBody := L.body
                        if not na(refPx)
                            if p.isHigh ? close < refPx : close > refPx
                                p.bosOn   := true
                                p.bosBody := refBody
                                p.bosCnt  := 0

            if drop
                array.remove(pends, i)
            else
                array.set(pends, i, p)

    // --- sweep detection on existing levels
    if array.size(lvls) > 0
        for i = array.size(lvls) - 1 to 0
            Lvl L = array.get(lvls, i)
            if L.bn < bar_index
                bool hit = L.isHigh ? high >= L.px : low <= L.px
                if hit
                    bool byClose = L.isHigh ? close > L.px : close < L.px
                    array.push(pends, Pend.new(L.px, L.body, L.isHigh, bar_index, L.isHigh ? high : low, byClose, 0, not byClose, false, na, 0))
                    array.remove(lvls, i)

    // --- level detection (3 closed candles: [2] [1] [0])
    bool bull1 = close[2] > open[2]
    bool bear1 = close[2] < open[2]
    bool bull2 = close[1] > open[1]
    bool bear2 = close[1] < open[1]
    bool bull3 = close    > open
    bool bear3 = close    < open

    bool newHigh = (bull1 and bear2 and bull3 and close <= close[2]) or (bull1 and bear2 and bear3)
    bool newLow  = (bear1 and bull2 and bear3 and close >= close[2]) or (bear1 and bull2 and bull3)

    if newHigh
        float px = math.max(high[2], high[1], high)
        bool dup = false
        if array.size(lvls) > 0
            for j = 0 to array.size(lvls) - 1
                Lvl L = array.get(lvls, j)
                if L.isHigh and L.px == px
                    dup := true
        if not dup
            array.push(lvls, Lvl.new(px, close[2], bar_index, true))

    if newLow
        float px = math.min(low[2], low[1], low)
        bool dup = false
        if array.size(lvls) > 0
            for j = 0 to array.size(lvls) - 1
                Lvl L = array.get(lvls, j)
                if not L.isHigh and L.px == px
                    dup := true
        if not dup
            array.push(lvls, Lvl.new(px, close[2], bar_index, false))

    // --- circle cleanup: close below a green circle / above a red circle
    if array.size(circs) > 0
        for i = array.size(circs) - 1 to 0
            Circ c = array.get(circs, i)
            if c.isHigh ? close > c.px : close < c.px
                label.delete(c.lb)
                array.remove(circs, i)

// ---------------- bias tint ----------------
bgcolor(useTint and bias != 0 ? color.new(bias > 0 ? cLow : cHigh, 90) : na)
